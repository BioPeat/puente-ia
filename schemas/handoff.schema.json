{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Puente IA handoff (v1.1 / v1.0)",
  "type": "object",
  "required": [
    "protocol_version",
    "task_id",
    "direction",
    "project",
    "repo_url",
    "source_commit",
    "created_at",
    "objective",
    "files"
  ],
  "properties": {
    "protocol_version": { "enum": ["1.0", "1.1"] },
    "task_id": { "type": "string", "minLength": 8, "pattern": "^[A-Za-z0-9._-]+$" },
    "direction": { "enum": ["antigravity_to_copilot", "copilot_to_antigravity"] },
    "origin_mode": { "enum": ["reply_to_handoff", "copilot_from_scratch"] },
    "project": { "type": "string", "minLength": 1 },
    "repo_url": { "type": "string", "pattern": "^https://github\\.com/.+/.+(\\.git)?$" },
    "branch": { "type": "string" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
    "created_at": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "deleted_files": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
